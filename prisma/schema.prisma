// AlgoRank — database schema.
//
// Design notes (see PLAN.md §3 for full rationale):
//   * Every entity that originates outside our DB carries (source, sourceId).
//     A unique constraint on (source, sourceId) provides idempotent upserts.
//   * Every such entity also carries `rawJson` so we never lose upstream data
//     we did not model.
//   * The model is game-agnostic. We filter to Melee at ingest, but the schema
//     itself does not assume Smash.
//   * SQLite for local dev; the schema is written to migrate cleanly to
//     PostgreSQL later (no SQLite-only types are used).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Source taxonomy
// ----------------------------------------------------------------------------

// Stored as TEXT for SQLite portability; values are constants in TypeScript.
//
//   STARTGG    — pulled from the start.gg GraphQL API
//   MANUAL     — entered by hand or via ad-hoc importer
//   LIQUIPEDIA — future
//   SMASHWIKI  — future

// ----------------------------------------------------------------------------
// Reference tables (videogame, character, stage)
// ----------------------------------------------------------------------------

model Videogame {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  externalKey String   @unique
  name        String
  displayName String?
  slug        String?
  rawJson     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]

  @@unique([source, sourceId])
  @@index([slug])
}

model Character {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  externalKey String   @unique
  name        String
  imageUrl    String?
  rawJson     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  selections GameSelection[]

  @@unique([source, sourceId])
}

model Stage {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  externalKey String   @unique
  name        String
  imageUrl    String?
  rawJson     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  games Game[]

  @@unique([source, sourceId])
}

// ----------------------------------------------------------------------------
// Identity (User -> Player -> Participant)
// ----------------------------------------------------------------------------

model User {
  id            Int      @id @default(autoincrement())
  source        String
  sourceId      String
  externalKey   String   @unique
  slug          String?
  discriminator String?
  name          String?
  bio           String?
  location      String?
  genderPronoun String?
  rawJson       String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  players Player[]

  @@unique([source, sourceId])
  @@index([slug])
}

model Player {
  id          Int      @id @default(autoincrement())
  source      String
  sourceId    String
  externalKey String   @unique
  gamerTag    String?
  prefix      String?
  userId      Int?
  rawJson     String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  participants Participant[]

  @@unique([source, sourceId])
  @@index([gamerTag])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// Tournament hierarchy
// ----------------------------------------------------------------------------

model Tournament {
  id                     Int      @id @default(autoincrement())
  source                 String
  sourceId               String
  externalKey            String   @unique
  name                   String
  slug                   String?
  shortSlug              String?
  startAt                DateTime?
  endAt                  DateTime?
  registrationClosesAt   DateTime?
  timezone               String?
  city                   String?
  addrState              String?
  countryCode            String?
  postalCode             String?
  lat                    Float?
  lng                    Float?
  venueName              String?
  venueAddress           String?
  hashtag                String?
  currency               String?
  isOnline               Boolean?
  hasOfflineEvents       Boolean?
  hasOnlineEvents        Boolean?
  numAttendees           Int?
  ownerSourceId          String?
  primaryContact         String?
  primaryContactType     String?
  mapsPlaceId            String?
  rules                  String?
  url                    String?
  rawJson                String?
  firstSeenAt            DateTime @default(now())
  lastSeenAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  events             Event[]
  periodInclusions   RankingPeriodTournament[]

  @@unique([source, sourceId])
  @@index([slug])
  @@index([startAt])
}

model Event {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String
  externalKey     String   @unique
  tournamentId    Int
  videogameId     Int?
  name            String
  slug            String?
  type            Int?     // 1 = singles, 5 = teams (start.gg convention; preserved verbatim)
  startAt         DateTime?
  state           Int?
  numEntrants     Int?
  teamRosterSize  Int?
  isOnline        Boolean?
  prizingInfo     String?
  rulesetId       Int?
  useEventSeeds   Boolean?
  ownerSourceId   String?
  rawJson         String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Set when ingestRange has finished pulling everything for this event
  // (entrants, standings, all sets across all phase groups). On re-runs we
  // skip events with a non-null marker unless --force is passed.
  ingestionCompletedAt DateTime?

  tournament           Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  videogame            Videogame?                 @relation(fields: [videogameId], references: [id])
  phases               Phase[]
  entrants             Entrant[]
  sets                 Set[]
  standings            Standing[]
  eligibilityOverride  EventEligibilityOverride?

  @@unique([source, sourceId])
  @@index([tournamentId])
  @@index([videogameId])
  @@index([slug])
  @@index([name])
}

model Phase {
  id            Int      @id @default(autoincrement())
  source        String
  sourceId      String
  externalKey   String   @unique
  eventId       Int
  name          String?
  phaseOrder    Int?
  numSeeds      Int?
  bracketType   String?
  groupCount    Int?
  isExhibition  Boolean?
  state         Int?
  rawJson       String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phaseGroups PhaseGroup[]

  @@unique([source, sourceId])
  @@index([eventId])
}

model PhaseGroup {
  id                Int      @id @default(autoincrement())
  source            String
  sourceId          String
  externalKey       String   @unique
  phaseId           Int
  displayIdentifier String?
  bracketType       String?
  firstRoundTime    DateTime?
  state             Int?
  waveSourceId      String?
  numRounds         Int?
  rawJson           String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  phase     Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  sets      Set[]
  standings Standing[]

  @@unique([source, sourceId])
  @@index([phaseId])
}

// ----------------------------------------------------------------------------
// Entrants and participants
// ----------------------------------------------------------------------------

model Entrant {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String
  externalKey     String   @unique
  eventId         Int
  name            String?
  isDisqualified  Boolean?
  initialSeedNum  Int?
  finalPlacement  Int?
  rawJson         String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event                      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants               Participant[]
  slots                      SetSlot[]
  games                      Game[]
  selections                 GameSelection[]
  standings                  Standing[]
  setOverridesAsCorrectedWin SetOverride[]

  @@unique([source, sourceId])
  @@index([eventId])
  @@index([name])
}

model Participant {
  id           Int      @id @default(autoincrement())
  source       String
  sourceId     String
  externalKey  String   @unique
  entrantId    Int
  playerId     Int?
  gamerTag     String?
  prefix       String?
  rawJson      String?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entrant    Entrant         @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  player     Player?         @relation(fields: [playerId], references: [id])
  selections GameSelection[]

  @@unique([source, sourceId])
  @@index([entrantId])
  @@index([playerId])
  @@index([gamerTag])
}

// ----------------------------------------------------------------------------
// Sets, slots, games, selections
// ----------------------------------------------------------------------------

model Set {
  id                Int      @id @default(autoincrement())
  source            String
  sourceId          String
  externalKey       String   @unique
  eventId           Int
  phaseGroupId      Int?
  identifier        String?
  displayScore      String?
  fullRoundText     String?
  round             Int?
  startedAt         DateTime?
  completedAt       DateTime?
  state             Int?
  totalGames        Int?
  winnerEntrantId   Int?
  loserEntrantId    Int?
  isGF              Boolean?
  lPlacement        Int?
  wPlacement        Int?
  hasPlaceholder    Boolean?
  hasErrors         Boolean?
  station           String?
  streamSourceId    String?
  vodUrl            String?
  setGamesType      Int?
  rawJson           String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phaseGroup PhaseGroup?  @relation(fields: [phaseGroupId], references: [id])
  slots      SetSlot[]
  games      Game[]
  override   SetOverride?

  @@unique([source, sourceId])
  @@index([eventId])
  @@index([phaseGroupId])
  @@index([completedAt])
  @@index([winnerEntrantId])
  @@index([loserEntrantId])
}

// SetSlot is the bracket-reconstruction backbone: each slot records what fed
// it (a previous set's winner/loser, a seed, a bye). See PLAN.md §3.3.
model SetSlot {
  id                  Int      @id @default(autoincrement())
  source              String
  sourceId            String
  externalKey         String   @unique
  setId               Int
  slotIndex           Int
  entrantId           Int?
  seedNum             Int?
  prereqType          String?  // "set" | "seed" | "bye"
  prereqSourceSetId   String?  // sourceId of the set whose result fills this slot
  prereqPlacement     Int?     // 1 = winner, 2 = loser, etc.
  rawJson             String?
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  set     Set      @relation(fields: [setId], references: [id], onDelete: Cascade)
  entrant Entrant? @relation(fields: [entrantId], references: [id])

  @@unique([source, sourceId])
  @@unique([setId, slotIndex])
  @@index([setId])
  @@index([entrantId])
  @@index([prereqSourceSetId])
}

model Game {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String
  externalKey     String   @unique
  setId           Int
  orderNum        Int      // 1-indexed game number within the set
  winnerEntrantId Int?
  state           Int?
  stageId         Int?
  // For Smash games, score is stocks remaining (per start.gg docs).
  entrant1Score   Int?
  entrant2Score   Int?
  rawJson         String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  set        Set             @relation(fields: [setId], references: [id], onDelete: Cascade)
  winner     Entrant?        @relation(fields: [winnerEntrantId], references: [id])
  stage      Stage?          @relation(fields: [stageId], references: [id])
  selections GameSelection[]

  @@unique([source, sourceId])
  @@unique([setId, orderNum])
  @@index([setId])
  @@index([stageId])
  @@index([winnerEntrantId])
}

model GameSelection {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String
  externalKey     String   @unique
  gameId          Int
  entrantId       Int?
  participantId   Int?
  characterId     Int?
  selectionType   String?
  selectionValue  Int?
  orderNum        Int?
  rawJson         String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  entrant     Entrant?     @relation(fields: [entrantId], references: [id])
  participant Participant? @relation(fields: [participantId], references: [id])
  character   Character?   @relation(fields: [characterId], references: [id])

  @@unique([source, sourceId])
  @@index([gameId])
  @@index([entrantId])
  @@index([participantId])
  @@index([characterId])
}

// ----------------------------------------------------------------------------
// Standings (final placements). Importantly: not foreign-keyed to sets, so a
// "results-list-only" tournament with no bracket data still fits cleanly.
// ----------------------------------------------------------------------------

model Standing {
  id            Int      @id @default(autoincrement())
  source        String
  sourceId      String
  externalKey   String   @unique
  eventId       Int?
  phaseGroupId  Int?
  entrantId     Int?
  placement     Int?
  isFinal       Boolean?
  totalPoints   Float?
  metadata      String?  // arbitrary JSON for non-standard formats (race, etc.)
  rawJson       String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event      Event?      @relation(fields: [eventId], references: [id])
  phaseGroup PhaseGroup? @relation(fields: [phaseGroupId], references: [id])
  entrant    Entrant?    @relation(fields: [entrantId], references: [id])

  @@unique([source, sourceId])
  @@index([eventId, placement])
  @@index([phaseGroupId, placement])
  @@index([entrantId])
}

// ----------------------------------------------------------------------------
// Ingestion bookkeeping
// ----------------------------------------------------------------------------

model IngestionRun {
  id            Int      @id @default(autoincrement())
  source        String
  mode          String   // "range" | "tournament" | "weekly" | "introspect" | ...
  paramsJson    String   // verbatim CLI args / filters
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  status        String   @default("running") // "running" | "succeeded" | "failed"
  errorMessage  String?

  checkpoints IngestionCheckpoint[]

  @@index([source, mode])
  @@index([startedAt])
}

// One row per (run, scope-key, stage). Stages: "tournament", "events",
// "phases", "phase_groups", "entrants", "sets", "standings".
model IngestionCheckpoint {
  id         Int      @id @default(autoincrement())
  runId      Int
  scopeKey   String   // e.g. "tournament:STARTGG:517161"
  stage      String
  page       Int      @default(0)
  done       Boolean  @default(false)
  metaJson   String?
  updatedAt  DateTime @updatedAt

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, scopeKey, stage])
  @@index([runId])
}

// ----------------------------------------------------------------------------
// Curation layer
//
// See PLAN.md §9. Three principles:
//   1. All curation decisions are *global facts*, not period-scoped. A merge
//      or exclusion made while doing the 2025 ranking still applies when
//      computing 2024–25. `createdInPeriodId` is provenance only.
//   2. Decisions are reversible — we never mutate the source-of-truth row
//      (Event, Set, etc.). Override rows store the change; the original
//      stays intact and is shown as "result was X, overwritten to Y."
//   3. Eligibility / effective result is *derived* at query time from the
//      override rows. No backfill needed when a rule changes.
//
// Player merges are NOT in this slice — that's the next iteration.
// ----------------------------------------------------------------------------

model RankingPeriod {
  id          Int      @id @default(autoincrement())
  name        String   @unique          // e.g. "2025 Yearly", "2024 Summer"
  kind        String                    // "yearly" | "summer" | "custom"
  startAt     DateTime                  // inclusive
  endAt       DateTime                  // inclusive
  videogameId Int?                      // null = game-agnostic (rare)
  eventType   Int?                      // 1 = singles, 5 = doubles, null = any
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournamentInclusions      RankingPeriodTournament[]
  eventNameRules            EventNameRule[]
  eventEligibilityOverrides EventEligibilityOverride[]
  setOverrides              SetOverride[]

  @@index([startAt, endAt])
}

// Per-tournament override of the period's date-window default. Without a row,
// a tournament is in scope iff event.startAt ∈ [period.startAt, period.endAt]
// (and game / type match). A row forces inclusion or exclusion regardless of
// where the tournament falls relative to the window.
model RankingPeriodTournament {
  id           Int      @id @default(autoincrement())
  periodId     Int
  tournamentId Int
  included     Boolean                    // true = force in; false = force out
  reason       String?
  createdAt    DateTime @default(now())

  period     RankingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([periodId, tournamentId])
  @@index([periodId])
  @@index([tournamentId])
}

// Default-deny event eligibility. Events whose normalized name is not in this
// table are ineligible. `normalizedName` is name.toLowerCase().trim() with
// internal whitespace collapsed — kept deliberately conservative so the
// frequency-sorted review queue stays small.
model EventNameRule {
  id                 Int      @id @default(autoincrement())
  normalizedName     String   @unique
  eligible           Boolean                  // false = explicit blacklist
  reason             String?
  createdInPeriodId  Int?                     // provenance, decision is global
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdInPeriod RankingPeriod? @relation(fields: [createdInPeriodId], references: [id])

  @@index([eligible])
}

// Per-event eligibility override — escape hatch for cases the name rule gets
// wrong (e.g. a "Melee Singles" event that was actually an exhibition, or a
// custom-named event that should be eligible despite the name rule).
model EventEligibilityOverride {
  id                 Int      @id @default(autoincrement())
  eventId            Int      @unique
  eligible           Boolean
  reason             String
  createdInPeriodId  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdInPeriod RankingPeriod? @relation(fields: [createdInPeriodId], references: [id])
}

// Per-set override. One row per set; the `kind` distinguishes pure exclusion
// from a result correction. For corrections, `correctedWinnerEntrantId` and
// `correctedDisplayScore` carry the corrected values; readers compute the
// "effective" result via lib/curation/setResult.ts.
//
// The original Set row is never mutated — the bracket viz and any future
// audit view can show "result was X, overwritten to Y because Z."
model SetOverride {
  id                          Int      @id @default(autoincrement())
  setId                       Int      @unique
  kind                        String                  // "EXCLUDE" | "CORRECT_RESULT"
  reason                      String
  correctedWinnerEntrantId    Int?                    // CORRECT_RESULT only
  correctedDisplayScore       String?                 // CORRECT_RESULT only
  createdInPeriodId           Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  set                     Set            @relation(fields: [setId], references: [id], onDelete: Cascade)
  correctedWinnerEntrant  Entrant?       @relation(fields: [correctedWinnerEntrantId], references: [id])
  createdInPeriod         RankingPeriod? @relation(fields: [createdInPeriodId], references: [id])

  @@index([kind])
}
