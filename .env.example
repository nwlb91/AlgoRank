# --- Database -------------------------------------------------------------
# Any PostgreSQL 14+ connection string. Examples:
#   docker compose:  postgresql://algorank:algorank@db:5432/algorank
#   Neon/Supabase:   postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://algorank:algorank@127.0.0.1:5432/algorank
POSTGRES_PASSWORD=algorank

# --- start.gg ---------------------------------------------------------------
# Create at https://start.gg -> Developer Settings (profile > developer).
# NOTE: tokens expire after 1 year — set a reminder to rotate.
STARTGG_API_TOKEN=

# --- parry.gg ---------------------------------------------------------------
# Create an API key from your parry.gg account (developer settings).
PARRY_API_KEY=

# --- Tuning (defaults are sensible; all optional) ---------------------------
# STARTGG_RPM=70                # max 80/min allowed by start.gg
# PARRY_RPS=4
# BACKFILL_START=2014-06-01     # earliest tournament date to discover
# SYNC_OVERLAP_DAYS=45          # re-scan window for late edits
# SYNC_HORIZON_DAYS=400         # how far ahead to discover upcoming tournaments
# FINALIZE_AFTER_DAYS=60        # freeze events N days after tournament end
# MAX_RUNTIME_MINUTES=0         # >0 = stop gracefully after N minutes (resumable)
# LOG_LEVEL=INFO
