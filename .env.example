# start.gg API token. Create one at:
#   https://start.gg/admin/profile/developer
# Tokens expire after 1 year. Keep this file out of git.
START_GG_TOKEN=

# Where the local SQLite DB lives. Prisma reads this. Note: paths are
# resolved relative to prisma/schema.prisma, so this places the DB at
# prisma/algorank.db (next to the schema).
DATABASE_URL="file:./algorank.db"

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info
